{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	// wrangler.jsonc
"name": "arcadex-solana",
	"compatibility_date": "2026-01-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"keep_vars": true,
	"observability": {
		"enabled": true
	},
	/**
	 * Named environments — always deploy with --env preview|production.
	 * Bindings (KV / D1 / services) are NOT inherited across envs in Wrangler;
	 * each block must declare its own.
	 *
	 * Deploy:
	 *   npm run deploy:preview
	 *   npm run deploy:production
	 *
	 * D1 and KV ids below are ArcadeX Solana only.
	 * Never bind arcadex-celo-preview / arcadex-celo-prod or the Celo KV namespaces.
	 */
	"env": {
		"preview": {
			"name": "arcadex-solana-preview",
			"vars": {
				"PLAYER_DATA_BACKEND": "d1",
				"DAILY_PLAY_MODE": "streak",
				"NEXT_PUBLIC_DAILY_PLAY_MODE": "streak",
				"D1_DATABASE_ID": "251e9f61-6c6e-4cb6-980a-f489feb43a70",
				"KV_NAMESPACE_ID": "403653bebdd24f1c8c8b50ff52b61709"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "arcadex-solana-preview"
				}
			],
			"kv_namespaces": [
				{
					"binding": "RATE_LIMIT_KV",
					"id": "403653bebdd24f1c8c8b50ff52b61709"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "arcadex-solana-preview",
					"database_id": "251e9f61-6c6e-4cb6-980a-f489feb43a70",
					"migrations_dir": "migrations",
					"preview_database_id": "arcadex-solana-preview-local"
				}
			]
		},
		"production": {
			"name": "arcadex-solana",
			"vars": {
				"PLAYER_DATA_BACKEND": "d1",
				"DAILY_PLAY_MODE": "streak",
				"NEXT_PUBLIC_DAILY_PLAY_MODE": "streak",
				"D1_DATABASE_ID": "b167f6b7-3228-4537-a68e-cbdca4194502",
				"KV_NAMESPACE_ID": "d2e29af34e3541df9fdde0b527544ded"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "arcadex-solana"
				}
			],
			"kv_namespaces": [
				{
					"binding": "RATE_LIMIT_KV",
					"id": "d2e29af34e3541df9fdde0b527544ded"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "arcadex-solana-prod",
					"database_id": "b167f6b7-3228-4537-a68e-cbdca4194502",
					"migrations_dir": "migrations"
				}
			]
		}
	}
}