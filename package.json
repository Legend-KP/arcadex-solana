{
  "name": "arcadex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --env preview",
    "deploy": "npm run deploy:preview",
    "deploy:preview": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env preview",
    "deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload --env preview",
    "cf-typegen": "wrangler types --env preview --env-interface CloudflareEnv cloudflare-env.d.ts",
    "verify:cdn": "node scripts/verify-game-cdn.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.6.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^5.0.0",
    "jose": "^6.2.3",
    "next": "15.5.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.5.27",
    "typescript": "^5.8.0",
    "wrangler": "^4.20.0"
  }
}
